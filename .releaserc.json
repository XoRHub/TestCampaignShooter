{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/bump-chart-version.mjs ${nextRelease.version} && (cd deploy/helm/testcampaignshooter && helm-docs --sort-values-order file)"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "deploy/helm/testcampaignshooter/Chart.yaml",
          "deploy/helm/testcampaignshooter/README.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/gitlab",
      {
        "assets": [
          { "path": "sbom-server.cdx.json", "label": "SBOM (server image, CycloneDX)" },
          { "path": "sbom-portal.cdx.json", "label": "SBOM (portal image, CycloneDX)" }
        ]
      }
    ]
  ]
}
