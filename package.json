{
  "name": "testcampaignshooter",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    },
    "overrides": {
      "fast-uri": "^3.1.9",
      "sharp": "^0.35.5",
      "find-my-way": "^9.7.0",
      "postcss": "^8.5.18",
      "brace-expansion": "^2.1.4",
      "picomatch": "^4.0.4",
      "tar": "^7.5.19",
      "sigstore": "^4.1.1",
      "npm": "^11.18.0",
      "ip-address": "^10.3.1",
      "undici": "^7.29.0",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.18",
      "deepmerge-ts": "^8.0.2",
      "source-map-js": "^1.2.2"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @tcs/server dev",
    "dev:portal": "pnpm --filter @tcs/portal dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.0",
    "@semantic-release/npm": "^12.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.30.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "semantic-release": "^24.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
