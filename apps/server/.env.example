# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
# Base URL the Argo aggregation step uses to call back (must be reachable from pods)
PUBLIC_BASE_URL=http://localhost:4000
# Origin of the portal, for CORS + OIDC redirects
PORTAL_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tcs:tcs@localhost:5432/tcs

# ── Orchestration provider (pluggable: argo | docker | local) ──────────────
# argo   : Workflows Kubernetes (production — un pod par test)
# docker : chaque test encapsulé dans son image de conteneur via docker run
#          (équivalent mono-machine d'un pod Argo — dev avec Docker)
# local  : child processes hôte (dev sans Docker)
ORCHESTRATION_PROVIDER=local
# Runtime du provider "local" (process | docker) + binaire docker optionnel
LOCAL_PROVIDER_RUNTIME=process
LOCAL_PROVIDER_DOCKER_BIN=docker
# Racine des workspaces de test (défaut : tmpdir). Si le serveur tourne en
# conteneur avec le runtime docker, ce chemin doit être visible du démon hôte.
LOCAL_PROVIDER_WORKSPACE_DIR=
K8S_NAMESPACE=argo
ARGO_SERVICE_ACCOUNT=testcampaignshooter
# Required for targeted retry (Argo Server API)
ARGO_SERVER_URL=
ARGO_SERVER_TOKEN=
ARGO_MANUAL_STEPS_DIR=deploy/argo/steps
ARGO_GIT_SECRET_NAME=
ARGO_ARTIFACT_PREFIX=tcs-runs

# ── Tests source defaults (overridable per campaign) ───────────────────────
DEFAULT_PARALLELISM=5
GIT_TOKEN=

# ── Internal results callback ───────────────────────────────────────────────
# Optional shared token: when set, POST /api/internal/runs/:id/results requires
# the x-tcs-token header (sent automatically by all providers).
INTERNAL_CALLBACK_TOKEN=

# ── Scheduler (lancements automatiques de campagnes par cron) ──────────────
# En multi-répliques, ne l'activer que sur UNE instance.
SCHEDULER_ENABLED=true
# Fuseau IANA appliqué aux expressions cron (défaut : celui du serveur)
SCHEDULER_TIMEZONE=Europe/Paris

# ── Authentication (each method can be toggled independently) ──────────────
AUTH_PASSWORD_ENABLED=true
AUTH_OIDC_ENABLED=false
SESSION_SECRET=change-me-32-chars-minimum-please!
SESSION_TTL_HOURS=12
# Bootstrap admin (created at startup when password auth is enabled)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
# OIDC provider (Keycloak, Azure AD, Google, Okta, ...)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=roles

# ── Artifact store (MinIO/S3) ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tcs
S3_SECRET_KEY=tcs-secret
S3_BUCKET=tcs-artifacts
S3_FORCE_PATH_STYLE=true

# ── Metrics ─────────────────────────────────────────────────────────────────
# /metrics (system Prometheus) is always on.
# Business metrics are pushed to a *separate*, dedicated target (Pushgateway)
# so test-result cardinality never pollutes the infra Prometheus.
BUSINESS_METRICS_ENABLED=false
PUSHGATEWAY_URL=http://localhost:9091
BUSINESS_METRICS_JOB=tcs-campaigns
# Optional basic auth for the pushgateway
PUSHGATEWAY_USERNAME=
PUSHGATEWAY_PASSWORD=
